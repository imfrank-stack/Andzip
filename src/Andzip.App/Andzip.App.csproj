<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Andzip</AssemblyName>
    <RootNamespace>Andzip.App</RootNamespace>
    <Version>0.9.0</Version>
    <ApplicationIcon>..\..\assets\andzip.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 桌面快捷方式要走 COM（IShellLinkW + IPersistFile）。裁剪发布默认把 .NET 的
         built-in COM 支持整个去掉，于是【未裁剪的测试全绿、打出来的 exe 一点安装就报
         "Built-in COM has been disabled via a feature switch"】—— 症状只在产物里出现。
         这个开关把它留着；build.ps1 还有一条 /selftest 门禁直接跑产物，防的就是这一类。 -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 单文件绿色版：把原生库（Skia 等）一并内嵌，运行时自解压（否则 exe 离开发布目录会因缺少 libSkiaSharp 崩溃） -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Andzip.Core\Andzip.Core.csproj" />
  </ItemGroup>

  <!-- 界面测试要看得到 internal（MainToolBar / MainMenuBar / RecycleBin 这一层都是应用内部零件）。
       没有这条的话"测试能跑"与"测试够得着"是两件事，之前就一直够不着。 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Andzip.App.UI.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\langs\*.lang" Link="langs\%(Filename)%(Extension)" />
    <None Include="..\..\langs\*.lang" Link="langs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 程序图标：exe 上的那份由 ApplicationIcon 管（shell 读），界面里（标题栏、Window.Icon）
       读的是这张内嵌 PNG。单文件绿色版没有旁边的 assets 目录，不内嵌就等于没有图标。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\andzip.png" Link="assets\andzip.png" />
  </ItemGroup>

  <!-- 首页工具栏那九枚双色图标。同样是内嵌而不是旁边的文件：单文件绿色版只有一个 exe，
       少一个 .svg 就少一枚图标，而"图标缺一个"这种毛病要到用户点进去才看得见。
       SvgGlyph 读的就是这一份，所以设计稿与屏幕上不可能长得不一样。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\svg\*.svg" Link="assets\svg\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>