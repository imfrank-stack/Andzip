<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- We marshal through System.Runtime.InteropServices only; no unsafe needed. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>Andzip.Native</AssemblyName>
    <RootNamespace>Andzip.Native</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Managed shell over libandzip_core, the cross-platform C compression engine in native/.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The native library is produced by native/CMakeLists.txt, not by MSBuild. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      If a prebuilt engine has been staged under runtimes/<rid>/native next to
      this project, copy it to the output so the resolver's second probe lands.
      Absent files are simply skipped (Condition guards the glob).
    -->
    <None Include="runtimes\**\*.dll;runtimes\**\*.so;runtimes\**\*.dylib"
          CopyToOutputDirectory="PreserveNewest"
          LinkBase="runtimes" />
  </ItemGroup>

</Project>
